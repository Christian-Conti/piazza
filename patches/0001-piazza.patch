+int32_t TgChat::Impl::ForumTopicIdByName(int64_t p_ChatId, const std::string& p_Name)
+{
+  auto chatIt = m_ForumTopicNames.find(p_ChatId);
+  if (chatIt == m_ForumTopicNames.end()) return 0;
+  for (const auto& topic : chatIt->second)
+  {
+    if (topic.second == p_Name) return topic.first;
+  }
+
+  return 0;
+}
