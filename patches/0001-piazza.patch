+
 #include <map>
 #include <utility>
 
@@ -42,6 +44,23 @@ void EmojiList::Init()
   // create table if not exists
   *m_Db << "CREATE TABLE IF NOT EXISTS emojis (name TEXT PRIMARY KEY NOT NULL, emoji TEXT, usages INT);";
 
+  // recency column (older dbs lack it; ALTER fails harmlessly if already present)
+  try
+  {
+    *m_Db << "ALTER TABLE emojis ADD COLUMN last_used INT DEFAULT 0;";
+  }
+  catch (const std::exception&)
+  {
+  }
+
+  try
+  {
+    *m_Db << "ALTER TABLE emojis ADD COLUMN category INT DEFAULT -1;";
+  }
+  catch (const std::exception&)
+  {
+  }
+
   // get expected count
   const std::set<std::string>& emojiView = EmojiUtil::GetView();
   const std::map<std::string, std::string>& emojiMap = EmojiUtil::GetMap();
@@ -89,6 +108,31 @@ void EmojiList::Init()
     }
     *m_Db << "COMMIT;";
   }
+
+  // assign Unicode group to emojis lacking one
+  int uncategorized = 0;
+  *m_Db << "SELECT COUNT(*) FROM emojis WHERE category = -1;" >> uncategorized;
+  if (uncategorized > 0)
+  {
+    std::vector<std::pair<std::string, std::string>> rows;
+    *m_Db << "SELECT name, emoji FROM emojis WHERE category = -1;" >>
+      [&](const std::string& name, const std::string& emoji) { rows.push_back(std::make_pair(name, emoji)); };
+
+    *m_Db << "BEGIN;";
+    for (const auto& row : rows)
+    {
+      std::string key = row.second;
+      for (size_t pos = key.find("\xEF\xB8\x8F"); pos != std::string::npos; pos = key.find("\xEF\xB8\x8F"))
+      {
+        key.erase(pos, 3); // strip variation selector-16
+      }
+
+      auto it = s_EmojiGroups.find(key);
+      const int category = (it != s_EmojiGroups.end()) ? it->second : 9;
+      *m_Db << "UPDATE emojis SET category = ? WHERE name = ?;" << category << row.first;
+    }
+    *m_Db << "COMMIT;";
+  }
 }
 
 void EmojiList::Cleanup()
@@ -100,24 +144,21 @@ void EmojiList::Cleanup()
   m_Db.reset();
 }
 
-std::vector<std::pair<std::string, std::string>> EmojiList::Get(const std::string& p_Filter)
+std::vector<std::pair<std::string, std::string>> EmojiList::Get(const std::string& p_Filter, int p_Category /*= -1*/)
 {
   std::unique_lock<std::mutex> lock(m_Mutex);
 
   if (!m_Db) return std::vector<std::pair<std::string, std::string>>();
 
+  std::string where = "WHERE name LIKE ?";
+  if (p_Category == -2) where += " AND last_used > 0";
+  else if (p_Category >= 0) where += " AND category = " + std::to_string(p_Category);
+
   std::vector<std::pair<std::string, std::string>> emojis;
-  if (p_Filter.empty())
-  {
-    *m_Db << "SELECT name, emoji FROM emojis ORDER BY usages DESC, name ASC;" >>
-      [&](const std::string& name, const std::string& emoji) { emojis.push_back(std::make_pair(name, emoji)); };
-  }
-  else
-  {
-    *m_Db << "SELECT name, emoji FROM emojis WHERE name LIKE ? ORDER BY usages DESC, name ASC;" <<
-      ("%" + p_Filter + "%") >>
-      [&](const std::string& name, const std::string& emoji) { emojis.push_back(std::make_pair(name, emoji)); };
-  }
+  *m_Db << ("SELECT name, emoji FROM emojis " + where +
+            " ORDER BY (last_used > 0) DESC, last_used DESC, usages DESC, name ASC;") <<
+    ("%" + p_Filter + "%") >>
+    [&](const std::string& name, const std::string& emoji) { emojis.push_back(std::make_pair(name, emoji)); };
 
   return emojis;
 }
@@ -128,5 +169,5 @@ void EmojiList::AddUsage(const std::string& p_Name)
 
   if (!m_Db) return;
 
-  *m_Db << "UPDATE emojis SET usages = usages + 1 WHERE name = ?;" << p_Name;
+  *m_Db << "UPDATE emojis SET usages = usages + 1, last_used = CAST(strftime('%s','now') AS INT) WHERE name = ?;" << p_Name;
 }
