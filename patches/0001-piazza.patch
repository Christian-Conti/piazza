+// "WhatsAppMd_+39..." -> "WhatsAppMd", "Telegram_+39..." -> "Telegram"
+std::string UiModel::Impl::ProtocolOf(const std::string& p_ProfileId)
+{
+  const size_t sep = p_ProfileId.find('_');
+  return (sep == std::string::npos) ? p_ProfileId : p_ProfileId.substr(0, sep);
+}
+
+static int TabPriority(const std::string& p_Protocol)
+{
+  if (p_Protocol.rfind("WhatsApp", 0) == 0) return 0;
+  if (p_Protocol.rfind("Telegram", 0) == 0) return 1;
+  if (p_Protocol.rfind("Signal", 0) == 0) return 2;
+  return 3;
+}
+
+// Tab list = protocols that have chats, ordered WhatsApp, Telegram, Signal, then the rest alphabetically
+void UiModel::Impl::RefreshTabs()
+{
+  std::set<std::string> protocols;
+  for (const auto& profile : m_ChatSet)
+  {
+    if (!profile.second.empty()) protocols.insert(ProtocolOf(profile.first));
+  }
+
+  m_Tabs.assign(protocols.begin(), protocols.end());
+  std::stable_sort(m_Tabs.begin(), m_Tabs.end(), [](const std::string& l, const std::string& r)
+  {
+    return TabPriority(l) < TabPriority(r);
+  });
+}
+
+int UiModel::Impl::GetTabCount()
+{
+  RefreshTabs();
+  return (int)m_Tabs.size();
+}
+
+int UiModel::Impl::GetTab()
+{
+  RefreshTabs();
+  auto it = std::find(m_Tabs.begin(), m_Tabs.end(), m_TabName);
+  return (it == m_Tabs.end()) ? 0 : (int)std::distance(m_Tabs.begin(), it);
+}
+
+// display name: "WhatsAppMd" -> "WhatsApp"
+std::string UiModel::Impl::GetTabName(int p_Tab)
+{
+  RefreshTabs();
+  if ((p_Tab < 0) || (p_Tab >= (int)m_Tabs.size())) return "";
+  std::string name = m_Tabs.at(p_Tab);
+  if ((name.size() > 2) && (name.compare(name.size() - 2, 2, "Md") == 0)) name.resize(name.size() - 2);
+  return name;
+}
+
+// WhatsApp = 0 (green), Telegram = 1 (blue), Signal = 2 (cyan), others spread over 3..5
+int UiModel::Impl::GetTabKind(int p_Tab)
+{
+  RefreshTabs();
+  if ((p_Tab < 0) || (p_Tab >= (int)m_Tabs.size())) return 0;
+  const std::string& protocol = m_Tabs.at(p_Tab);
+  const int priority = TabPriority(protocol);
+  if (priority < 3) return priority;
+  return 3 + (int)(std::hash<std::string>()(protocol) % 3);
+}
+
+int UiModel::Impl::GetProfileKind(const std::string& p_ProfileId)
+{
+  RefreshTabs();
+  auto it = std::find(m_Tabs.begin(), m_Tabs.end(), ProtocolOf(p_ProfileId));
+  return (it == m_Tabs.end()) ? 0 : GetTabKind((int)std::distance(m_Tabs.begin(), it));
+}
+
+bool UiModel::Impl::InActiveTab(const std::string& p_ProfileId)
+{
+  RefreshTabs();
+  if (m_Tabs.empty()) return true;
+  const std::string& active = (std::find(m_Tabs.begin(), m_Tabs.end(), m_TabName) == m_Tabs.end()) ? m_Tabs.front()
+                                                                                                      : m_TabName;
+  return ProtocolOf(p_ProfileId) == active;
+}
+
+int UiModel::Impl::GetTabUnread(int p_Tab)
+{
+  RefreshTabs();
+  if ((p_Tab < 0) || (p_Tab >= (int)m_Tabs.size())) return 0;
+  const std::string& protocol = m_Tabs.at(p_Tab);
+  int count = 0;
+  for (const auto& chat : m_ChatVec)
+  {
+    if ((ProtocolOf(chat.first) == protocol) && GetChatIsUnread(chat.first, chat.second)) ++count;
+  }
+
+  return count;
+}
+
+int UiModel::Impl::FirstChatInTab()
+{
+  for (int i = 0; i < (int)m_ChatVec.size(); ++i)
+  {
+    if (InActiveTab(m_ChatVec.at(i).first)) return i;
+  }
+
+  return -1;
+}
+
+// next (+1) / previous (-1) chat index within the active tab, wrapping; -1 if tab has no chats
+int UiModel::Impl::StepChatInTab(int p_Dir)
+{
+  const int n = (int)m_ChatVec.size();
+  const int start = (m_CurrentChatIndex >= 0) ? m_CurrentChatIndex : ((p_Dir > 0) ? -1 : n); // nothing open yet
+  for (int step = 1; step <= n; ++step)
+  {
+    int i = ((start + p_Dir * step) % n + n) % n;
+    if (InActiveTab(m_ChatVec.at(i).first)) return i;
+  }
+
+  return -1;
+}
+
+void UiModel::Impl::OnKeySetTab(int p_Tab)
+{
+  AnyUserKeyInput();
+
+  RefreshTabs();
+  if (GetEditMessageActive() || (p_Tab < 0) || (p_Tab >= (int)m_Tabs.size()) || (p_Tab == GetTab())) return;
+
+  m_TabLastChat[m_Tabs.at(GetTab())] = m_CurrentChat;
+  m_TabName = m_Tabs.at(p_Tab);
+
+  int target = -1;
+  for (int i = 0; i < (int)m_ChatVec.size(); ++i)
+  {
+    if (!InActiveTab(m_ChatVec.at(i).first)) continue;
+    if (target == -1) target = i;
+    if (m_ChatVec.at(i) == m_TabLastChat[m_TabName])
+    {
+      target = i;
+      break;
+    }
+  }
+
+  if (target != -1)
+  {
+    m_CurrentChatIndex = target;
+    m_CurrentChat = m_ChatVec.at(target);
+    OnCurrentChatChanged();
+    SetSelectMessageActive(false);
+  }
+
+  UpdateList();
+}
+
+// Tab / Shift-Tab: cycle through the tabs
+void UiModel::Impl::OnKeyStepTab(int p_Dir)
+{
+  const int n = GetTabCount();
+  if (n < 2) return;
+  OnKeySetTab(((GetTab() + p_Dir) % n + n) % n);
+}
