+// message the next sent text will reply to: the selected one, or the one fixed with the reply key
+bool UiModel::Impl::GetSelectedMessagePreview(std::string& p_Name, std::string& p_Text)
+{
+  if (GetEditMessageActive()) return false;
+
+  const std::string& profileId = m_CurrentChat.first;
+  const std::string& chatId = m_CurrentChat.second;
+  const std::vector<std::string>& messageVec = m_MessageVec[profileId][chatId];
+  const int messageOffset = m_MessageOffset[profileId][chatId];
+
+  std::string msgId;
+  if (GetSelectMessageActive())
+  {
+    if (messageOffset >= (int)messageVec.size()) return false;
+    msgId = messageVec.at(messageOffset);
+  }
+  else if (HasReplyTarget())
+  {
+    msgId = m_ReplyMsgId;
+  }
+  else
+  {
+    return false;
+  }
+
+  const auto& messages = m_Messages[profileId][chatId];
+  auto it = messages.find(msgId);
+  if (it == messages.end()) return false;
+
+  const ChatMessage& msg = it->second;
+  p_Name = msg.isOutgoing ? "You" : GetContactName(profileId, msg.senderId);
+  p_Text = msg.text.empty() ? std::string() : StrUtil::Split(msg.text, '\n').at(0);
+  if (p_Text.empty() && !msg.fileInfo.empty())
+  {
+    p_Text = FileUtil::BaseName(ProtocolUtil::FileInfoFromHex(msg.fileInfo).filePath);
+  }
+
+  return true;
+}
