+// tap on a quote card: go to the message it quotes (already loaded: jump now, else ask the protocol to find it)
+void UiModel::Impl::JumpToQuotedOf(const std::string& p_MsgId)
+{
+  const std::string& profileId = m_CurrentChat.first;
+  const std::string& chatId = m_CurrentChat.second;
+  const auto& messages = m_Messages[profileId][chatId];
+  auto mit = messages.find(p_MsgId);
+  if ((mit == messages.end()) || mit->second.quotedId.empty()) return;
+
+  const std::string quotedId = mit->second.quotedId;
+  const std::vector<std::string>& messageVec = m_MessageVec[profileId][chatId];
+  if (std::find(messageVec.begin(), messageVec.end(), quotedId) != messageVec.end())
+  {
+    SelectMessageById(quotedId);
+  }
+  else
+  {
+    // not loaded: the cache search first, and as a safety net page back through the history until it shows up
+    LOG_INFO("jump to quoted %s: not loaded, searching", quotedId.c_str());
+    SelectMessageById(p_MsgId);
+    m_JumpTargetId = quotedId;
+    m_JumpTargetChat = m_CurrentChat;
+    m_JumpTries = 0;
+    m_JumpLastStepMs = TimeUtil::GetCurrentTimeMSec();
+    SetNotice("Looking for the quoted message...");
+    OnKeyJumpQuoted();
+  }
+}
+
+void UiModel::Impl::JumpToQuotedOfSelected()
+{
+  AnyUserKeyInput();
+  if (!GetSelectMessageActive() || GetEditMessageActive()) return;
+
+  const std::string& profileId = m_CurrentChat.first;
+  const std::string& chatId = m_CurrentChat.second;
+  const std::vector<std::string>& messageVec = m_MessageVec[profileId][chatId];
+  const int messageOffset = m_MessageOffset[profileId][chatId];
+  if (messageOffset >= (int)messageVec.size()) return;
+  JumpToQuotedOf(messageVec.at(messageOffset));
+}
