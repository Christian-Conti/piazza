diff --git a/lib/ncutil/src/uploadprogress.cpp b/lib/ncutil/src/uploadprogress.cpp
new file mode 100644
index 00000000..fc80226f
--- /dev/null
+++ b/lib/ncutil/src/uploadprogress.cpp
@@ -0,0 +1,64 @@
+// uploadprogress.cpp
+
+#include "uploadprogress.h"
+
+#include <sys/stat.h>
+
+#include <algorithm>
+#include <mutex>
+
+#include "timeutil.h"
+
+static std::mutex s_Mutex;
+static std::vector<UploadProgress::Item> s_Items;
+
+void UploadProgress::Start(const std::string& p_Path)
+{
+  std::unique_lock<std::mutex> lock(s_Mutex);
+  Item item;
+  item.path = p_Path;
+  item.startMs = TimeUtil::GetCurrentTimeMSec();
+  struct stat st;
+  if (stat(p_Path.c_str(), &st) == 0) item.size = st.st_size;
+  s_Items.push_back(item);
+}
+
+// Matches by path; tdlib may report a copy of the file, so fall back to the file size.
+void UploadProgress::Update(const std::string& p_Path, int64_t p_Uploaded, int64_t p_Total, bool p_Completed)
+{
+  std::unique_lock<std::mutex> lock(s_Mutex);
+  auto it = std::find_if(s_Items.begin(), s_Items.end(), [&](const Item& i) { return i.path == p_Path; });
+  if (it == s_Items.end())
+  {
+    it = std::find_if(s_Items.begin(), s_Items.end(), [&](const Item& i) { return (i.size > 0) && (i.size == p_Total); });
+  }
+
+  if (it == s_Items.end()) return;
+
+  if (p_Completed)
+  {
+    s_Items.erase(it);
+    return;
+  }
+
+  it->uploaded = p_Uploaded;
+  it->total = p_Total;
+}
+
+void UploadProgress::Done(const std::string& p_Path)
+{
+  std::unique_lock<std::mutex> lock(s_Mutex);
+  s_Items.erase(std::remove_if(s_Items.begin(), s_Items.end(), [&](const Item& i) { return i.path == p_Path; }),
+                s_Items.end());
+}
+
+std::vector<UploadProgress::Item> UploadProgress::Snapshot()
+{
+  std::unique_lock<std::mutex> lock(s_Mutex);
+  // safety net: forget transfers older than 30 minutes (e.g. a protocol that never reports back)
+  const int64_t now = TimeUtil::GetCurrentTimeMSec();
+  s_Items.erase(std::remove_if(s_Items.begin(), s_Items.end(),
+                               [&](const Item& i) { return (now - i.startMs) > (30 * 60 * 1000); }),
+                s_Items.end());
+  return s_Items;
+}
