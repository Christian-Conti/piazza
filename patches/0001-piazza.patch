+// chosen topic: new messages are sent to it and the newest message of that topic is selected
+void UiModel::Impl::SetSendTopic(const std::string& p_Topic)
+{
+  const std::string& profileId = m_CurrentChat.first;
+  const std::string& chatId = m_CurrentChat.second;
+  m_SendTopic[profileId][chatId] = p_Topic;
+  if (p_Topic.empty())
+  {
+    SetNotice("Topics: all (messages go to the default topic)");
+    UpdateHistory();
+    return;
+  }
+
+  const auto& messages = m_Messages[profileId][chatId];
+  const std::vector<std::string>& messageVec = m_MessageVec[profileId][chatId];
+  for (auto it = messageVec.rbegin(); it != messageVec.rend(); ++it)
+  {
+    auto mit = messages.find(*it);
+    if ((mit != messages.end()) && (mit->second.topic == p_Topic))
+    {
+      SelectMessageById(*it);
+      break;
+    }
+  }
+
+  SetNotice("Topic #" + p_Topic + ": new messages are sent there (Alt-G to change)");
+}
