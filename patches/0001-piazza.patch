+  // p_Topics: (topic name, loaded message count); the first row of the dialog is "all topics"
+  UiTopicListDialog(const UiDialogParams& p_Params, const std::vector<std::pair<std::string, int>>& p_Topics,
+                    const std::string& p_Current);
+  virtual ~UiTopicListDialog();
+
+  std::string GetSelectedTopic() const; // "" = all topics
