+// uploadprogress.h
+//
+// Registry of files being sent, so the UI can show a spinner / progress bar while the protocol uploads.
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+class UploadProgress
+{
+public:
+  struct Item
+  {
+    std::string path;
+    int64_t startMs = 0;
+    int64_t size = 0; // file size on disk
+    int64_t uploaded = 0; // bytes uploaded, only if the protocol reports progress
+    int64_t total = 0; // 0 = protocol reports no progress (indeterminate)
+  };
+
+  static void Start(const std::string& p_Path);
+  static void Update(const std::string& p_Path, int64_t p_Uploaded, int64_t p_Total, bool p_Completed);
+  static void Done(const std::string& p_Path);
+  static std::vector<Item> Snapshot();
+};
