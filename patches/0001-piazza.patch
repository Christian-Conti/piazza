+// 1..6 on the selected message: 👍 ❤️ 😂 😮 😢 🙏; pressing the one you already gave removes it
+void UiModel::Impl::QuickReact(int p_Index)
+{
+  static const std::vector<std::string> quick = { "\xF0\x9F\x91\x8D", "\xE2\x9D\xA4\xEF\xB8\x8F", "\xF0\x9F\x98\x82",
+                                                  "\xF0\x9F\x98\xAE", "\xF0\x9F\x98\xA2", "\xF0\x9F\x99\x8F" };
+  if ((p_Index < 0) || (p_Index >= (int)quick.size())) return;
+
+  std::string profileId, chatId, senderId, msgId, selfEmoji;
+  bool hasLimitedReactions = false;
+  if (!PreReact(profileId, chatId, senderId, msgId, selfEmoji, hasLimitedReactions)) return;
+
+  const std::string& chosen = quick.at(p_Index);
+  SetReact(profileId, chatId, senderId, msgId, selfEmoji, (selfEmoji == chosen) ? std::string() : chosen);
+}
