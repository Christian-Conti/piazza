+// progressTempFile counts the bytes read from the encrypted temp file while whatsmeow uploads it,
+// and reports them to the UI. A Seek back to 0 marks the end of encryption (reads after it are the upload).
+type progressTempFile struct {
+	*os.File
+	path     string
+	total    int64
+	reading  bool
+	uploaded int64
+	last     time.Time
+}
+
+func (p *progressTempFile) Seek(offset int64, whence int) (int64, error) {
+	if offset == 0 && whence == io.SeekStart {
+		p.reading = true
+		p.uploaded = 0 // a pass over the file for the video sidecar must not count as upload
+	}
+	return p.File.Seek(offset, whence)
+}
+
+func (p *progressTempFile) Read(b []byte) (int, error) {
+	n, err := p.File.Read(b)
+	if p.reading && n > 0 {
+		p.uploaded += int64(n)
+		if time.Since(p.last) > 150*time.Millisecond {
+			p.last = time.Now()
+			CWmUploadProgress(p.path, p.uploaded, p.total)
+		}
+	}
+	return n, err
+}
+
+// UploadWithProgress is client.Upload, but streamed so the upload can be reported.
+func UploadWithProgress(client *whatsmeow.Client, data []byte, mediaType whatsmeow.MediaType, filePath string) (whatsmeow.UploadResponse, error) {
+	tmp, err := os.CreateTemp("", "piazza-upload-*")
+	if err != nil {
+		return client.Upload(context.Background(), data, mediaType) // no temp file: upload without progress
+	}
+	defer func() {
+		_ = tmp.Close()
+		_ = os.Remove(tmp.Name())
+	}()
+	// encrypted size is the plaintext plus padding (<= 16) and a 10 byte MAC
+	pf := &progressTempFile{File: tmp, path: filePath, total: int64(len(data)) + 26}
+	resp, upErr := client.UploadReader(context.Background(), bytes.NewReader(data), pf, mediaType)
+	if upErr != nil {
+		// streamed upload failed: fall back to the plain upload, so progress can never make sending worse
+		LOG_WARNING(fmt.Sprintf("streamed upload failed (%v), retrying plain upload", upErr))
+		return client.Upload(context.Background(), data, mediaType)
+	}
+	return resp, nil
+}
