+{
+  static const bool enabled = (getenv("KITTY_WINDOW_ID") != nullptr);
+  return enabled;
+}
+
+bool IsImagePath(const std::string& p_Path)
+{
+  const size_t dot = p_Path.rfind('.');
+  if (dot == std::string::npos) return false;
+  std::string ext = p_Path.substr(dot + 1);
+  std::transform(ext.begin(), ext.end(), ext.begin(), ::tolower);
+  return (ext == "jpg") || (ext == "jpeg") || (ext == "png") || (ext == "webp") || (ext == "gif");
+}
+
+bool IsVideoPath(const std::string& p_Path)
+{
+  const size_t dot = p_Path.rfind('.');
+  if (dot == std::string::npos) return false;
+  std::string ext = p_Path.substr(dot + 1);
+  std::transform(ext.begin(), ext.end(), ext.begin(), ::tolower);
+  return (ext == "mp4") || (ext == "webm") || (ext == "mov") || (ext == "mkv") || (ext == "m4v") ||
+    (ext == "f4v") || (ext == "3gp") || (ext == "avi") || (ext == "mpg") || (ext == "mpeg");
+}
+
+bool CanThumbnailVideos()
+{
+  static const bool hasFfmpeg = (system("command -v ffmpeg >/dev/null 2>&1") == 0);
+  return hasFfmpeg;
+}
+
+static std::set<std::string> s_AutoIds;
+static std::set<std::string> s_AutoFiles;
+
+// Every file is also listed on disk, so a crash or kill -9 still gets cleaned at the next start.
+static std::string ManifestPath()
+{
+  return FileUtil::GetApplicationDir() + "/temp/autodl.list";
+}
+
+void DeleteAutoFiles()
+{
+  for (const auto& path : s_AutoFiles) std::remove(path.c_str());
+  s_AutoFiles.clear();
+  std::remove(ManifestPath().c_str());
+}
+
+void CleanupStale()
+{
+  FILE* f = fopen(ManifestPath().c_str(), "r");
+  if (f == nullptr) return;
+
+  char line[4096];
+  while (fgets(line, sizeof(line), f) != nullptr)
+  {
+    std::string path(line);
+    while (!path.empty() && ((path.back() == '\n') || (path.back() == '\r'))) path.pop_back();
+    if (!path.empty()) std::remove(path.c_str());
+  }
+
+  fclose(f);
+  std::remove(ManifestPath().c_str());
+}
+
+void MarkAutoDownload(const std::string& p_FileId) { s_AutoIds.insert(p_FileId); }
+bool IsAutoDownload(const std::string& p_FileId) { return s_AutoIds.count(p_FileId) > 0; }
+
+void RememberAutoFile(const std::string& p_Path)
+{
+  static const bool registered = (std::atexit(DeleteAutoFiles) == 0);
+  if (!registered || !s_AutoFiles.insert(p_Path).second) return;
+
+  FileUtil::MkDir(FileUtil::GetApplicationDir() + "/temp");
+  FILE* f = fopen(ManifestPath().c_str(), "a");
+  if (f != nullptr)
+  {
+    fputs((p_Path + "\n").c_str(), f);
+    fclose(f);
+  }
+}
+
+// shortcut: blocking ffmpeg call on first draw, cached afterwards; upgrade to async if slow
+static std::string ConvertToPng(const std::string& p_Path, const std::string& p_FrameArgs)
+{
+  if (!CanThumbnailVideos()) return "";
+
+  const std::string out = FileUtil::GetApplicationDir() + "/temp/thumb_" +
+    std::to_string(std::hash<std::string>()(p_Path)) + ".png";
+  if (FileUtil::Exists(out)) return out;
+
+  FileUtil::MkDir(FileUtil::GetApplicationDir() + "/temp");
+  const std::string cmd = "ffmpeg -loglevel quiet -y -i '" + StrUtil::EscapeSingleQuote(p_Path) + "' " + p_FrameArgs +
+    " '" + out + "' </dev/null >/dev/null 2>&1";
+  if (system(cmd.c_str()) != 0) return "";
+  if (!FileUtil::Exists(out)) return "";
+  RememberAutoFile(out); // converted copies are session-only too
+  return out;
+}
+
+std::string VideoThumbnail(const std::string& p_Path)
+{
+  return ConvertToPng(p_Path, "-frames:v 1 -vf scale=480:-2");
+}
+
+// kitty's decoder rejects some WhatsApp .webp variants (lossy + alpha); ffmpeg reads them, so go through PNG
+std::string DisplayablePath(const std::string& p_Path)
+{
+  const size_t dot = p_Path.rfind('.');
+  std::string ext = (dot == std::string::npos) ? "" : p_Path.substr(dot + 1);
+  std::transform(ext.begin(), ext.end(), ext.begin(), ::tolower);
+  if (ext != "webp") return p_Path;
+
+  const std::string png = ConvertToPng(p_Path, "-frames:v 1");
+  return png.empty() ? p_Path : png;
+}
+
+static void Run(const std::string& p_Args)
+{
+  // find kitten on PATH, else next to the kitty install; save/restore cursor around raw output
+  static const std::string kitten = "\"$(command -v kitten || echo \"$HOME/.local/kitty.app/bin/kitten\")\"";
+  fputs("\x1b" "7", stdout);
+  fflush(stdout);
+  const std::string cmd = kitten + " icat --stdin=no --transfer-mode=stream " + p_Args + " 2>/dev/null";
+  if (system(cmd.c_str()) != 0) {}
+  fputs("\x1b" "8", stdout);
+  fflush(stdout);
+}
+
+void Clear()
+{
+  if (Enabled() && !s_Signature.empty())
+  {
+    Run("--clear");
+  }
+
+  s_Signature.clear();
+}
+
+void Show(const std::vector<Placement>& p_Placements)
+{
+  if (!Enabled()) return;
+
+  std::string signature;
+  for (const auto& p : p_Placements)
+  {
+    signature += p.path + "|" + std::to_string(p.x) + "," + std::to_string(p.y) + "," + std::to_string(p.cols) +
+      "x" + std::to_string(p.rows) + ";";
+  }
+
+  if (signature == s_Signature) return;
+
+  Clear();
+  for (const auto& p : p_Placements)
+  {
+    Run("--align=left --place=" + std::to_string(p.cols) + "x" + std::to_string(p.rows) + "@" +
+        std::to_string(p.x) + "x" + std::to_string(p.y) + " '" + StrUtil::EscapeSingleQuote(p.path) + "'");
+  }
+
+  s_Signature = signature;
+}
+}
