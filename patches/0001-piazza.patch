diff --git a/src/uiaudio.cpp b/src/uiaudio.cpp
new file mode 100644
index 00000000..90d2418b
--- /dev/null
+++ b/src/uiaudio.cpp
@@ -0,0 +1,200 @@
+// uiaudio.cpp
+
+#include "uiaudio.h"
+
+#include <fcntl.h>
+#include <signal.h>
+#include <spawn.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+
+#include "strutil.h"
+#include "timeutil.h"
+
+extern char** environ;
+
+namespace UiAudio
+{
+static pid_t s_Pid = -1;
+static std::string s_Path;
+static bool s_Paused = false;
+static int64_t s_StartMs = 0;
+static int64_t s_PausedAtMs = 0;
+static int64_t s_PausedTotalMs = 0;
+static std::map<std::string, int> s_Durations;
+
+static std::string Ext(const std::string& p_Path)
+{
+  const size_t dot = p_Path.rfind('.');
+  std::string ext = (dot == std::string::npos) ? "" : p_Path.substr(dot + 1);
+  std::transform(ext.begin(), ext.end(), ext.begin(), ::tolower);
+  return ext;
+}
+
+bool IsAudioPath(const std::string& p_Path)
+{
+  const std::string ext = Ext(p_Path);
+  return (ext == "oga") || (ext == "ogg") || (ext == "opus") || (ext == "mp3") || (ext == "m4a") || (ext == "aac") ||
+    (ext == "amr") || (ext == "wav") || (ext == "flac");
+}
+
+bool IsVoiceNotePath(const std::string& p_Path)
+{
+  const std::string ext = Ext(p_Path);
+  return (ext == "oga") || (ext == "ogg") || (ext == "opus");
+}
+
+// shortcut: blocking ffprobe on first sight of a file, cached afterwards
+int Duration(const std::string& p_Path)
+{
+  auto it = s_Durations.find(p_Path);
+  if (it != s_Durations.end()) return it->second;
+
+  int seconds = 0;
+  const std::string cmd = "ffprobe -v error -show_entries format=duration -of csv=p=0 '" +
+    StrUtil::EscapeSingleQuote(p_Path) + "' 2>/dev/null";
+  FILE* pipe = popen(cmd.c_str(), "r");
+  if (pipe != nullptr)
+  {
+    char buf[64] = { 0 };
+    if (fgets(buf, sizeof(buf), pipe) != nullptr) seconds = (int)(atof(buf) + 0.5);
+    pclose(pipe);
+  }
+
+  s_Durations[p_Path] = seconds;
+  return seconds;
+}
+
+static int64_t ElapsedMs()
+{
+  const int64_t now = s_Paused ? s_PausedAtMs : TimeUtil::GetCurrentTimeMSec();
+  return std::max<int64_t>(0, now - s_StartMs - s_PausedTotalMs);
+}
+
+State GetState(const std::string& p_Path)
+{
+  State state;
+  if ((s_Pid > 0) && (s_Path == p_Path))
+  {
+    state.current = true;
+    state.paused = s_Paused;
+    state.elapsedSec = (int)(ElapsedMs() / 1000);
+  }
+
+  return state;
+}
+
+bool IsPlaying()
+{
+  return (s_Pid > 0) && !s_Paused;
+}
+
+void Stop()
+{
+  if (s_Pid > 0)
+  {
+    kill(s_Pid, SIGCONT);
+    kill(s_Pid, SIGTERM);
+    int status = 0;
+    waitpid(s_Pid, &status, 0);
+  }
+
+  s_Pid = -1;
+  s_Path.clear();
+  s_Paused = false;
+}
+
+static void StartPlayer(const std::string& p_Path)
+{
+  static const bool registered = (std::atexit(Stop) == 0);
+  (void)registered;
+
+  // PIAZZA_PLAYER overrides the player; otherwise ffplay, pw-play or paplay, whichever exists
+  std::string player;
+  const char* custom = getenv("PIAZZA_PLAYER");
+  if ((custom != nullptr) && (custom[0] != '\0'))
+  {
+    player = custom;
+  }
+  else if (system("command -v ffplay >/dev/null 2>&1") == 0)
+  {
+    player = "ffplay -nodisp -autoexit -loglevel quiet";
+  }
+  else if (system("command -v pw-play >/dev/null 2>&1") == 0)
+  {
+    player = "pw-play";
+  }
+  else if (system("command -v paplay >/dev/null 2>&1") == 0)
+  {
+    player = "paplay";
+  }
+  else
+  {
+    return;
+  }
+
+  const std::string cmd = "exec " + player + " '" + StrUtil::EscapeSingleQuote(p_Path) + "'";
+  posix_spawn_file_actions_t actions;
+  posix_spawn_file_actions_init(&actions);
+  posix_spawn_file_actions_addopen(&actions, 0, "/dev/null", O_RDONLY, 0);
+  posix_spawn_file_actions_addopen(&actions, 1, "/dev/null", O_WRONLY, 0);
+  posix_spawn_file_actions_addopen(&actions, 2, "/dev/null", O_WRONLY, 0);
+  const char* argv[] = { "sh", "-c", cmd.c_str(), nullptr };
+  pid_t pid = -1;
+  if (posix_spawnp(&pid, "sh", &actions, nullptr, const_cast<char* const*>(argv), environ) == 0)
+  {
+    s_Pid = pid;
+    s_Path = p_Path;
+    s_Paused = false;
+    s_StartMs = TimeUtil::GetCurrentTimeMSec();
+    s_PausedTotalMs = 0;
+  }
+
+  posix_spawn_file_actions_destroy(&actions);
+}
+
+void Toggle(const std::string& p_Path)
+{
+  if ((s_Pid > 0) && (s_Path == p_Path))
+  {
+    if (s_Paused)
+    {
+      kill(s_Pid, SIGCONT);
+      s_PausedTotalMs += TimeUtil::GetCurrentTimeMSec() - s_PausedAtMs;
+      s_Paused = false;
+    }
+    else
+    {
+      kill(s_Pid, SIGSTOP);
+      s_PausedAtMs = TimeUtil::GetCurrentTimeMSec();
+      s_Paused = true;
+    }
+
+    return;
+  }
+
+  Stop();
+  StartPlayer(p_Path);
+}
+
+bool Poll()
+{
+  if (s_Pid <= 0) return false;
+
+  int status = 0;
+  if (waitpid(s_Pid, &status, WNOHANG) == s_Pid)
+  {
+    s_Pid = -1;
+    s_Path.clear();
+    s_Paused = false;
+    return true;
+  }
+
+  return false;
+}
+}
