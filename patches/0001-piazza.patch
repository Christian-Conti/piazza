new file mode 100644
index 0000000..6682649
--- /dev/null
+++ b/src/uiimage.h
@@ -0,0 +1,35 @@
+// uiimage.h
+//
+// Inline image display in kitty-graphics-capable terminals (via `kitten icat`).
+
+#pragma once
+
+#include <string>
+#include <vector>
+
+namespace UiImage
+{
+struct Placement
+{
+  std::string path;
+  int x = 0; // screen cell column (0-based)
+  int y = 0; // screen cell row (0-based)
+  int cols = 0;
+  int rows = 0;
+};
+
+bool Enabled();
+bool IsImagePath(const std::string& p_Path);
+bool IsVideoPath(const std::string& p_Path); // mp4/webm/mov/mkv: Telegram/WhatsApp "GIFs" are mp4
+std::string DisplayablePath(const std::string& p_Path); // image path kitty can decode (webp -> png via ffmpeg)
+std::string VideoThumbnail(const std::string& p_Path); // first frame as PNG via ffmpeg, "" if unavailable
+bool CanThumbnailVideos(); // ffmpeg present
+// files nchat fetched on its own for inline display; deleted when the session ends
+void MarkAutoDownload(const std::string& p_FileId);
+bool IsAutoDownload(const std::string& p_FileId);
+void RememberAutoFile(const std::string& p_Path);
+void DeleteAutoFiles(); // delete everything fetched for inline display (idempotent)
+void CleanupStale(); // delete leftovers of a previous session that did not exit cleanly
+void Show(const std::vector<Placement>& p_Placements); // no-op if unchanged since last call
+void Clear();
+}
