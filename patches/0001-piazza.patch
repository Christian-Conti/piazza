+// uiimage.cpp
+//
+// shortcut: shells out to `kitten icat` per image on layout change, simple but spawns a process per
+// visible image; upgrade to native kitty graphics protocol (id + placement) if this gets slow.
+
+#include "uiimage.h"
+
