+// timer: while a quoted message is being looked for, check if it arrived, else load older history
+void UiModel::Impl::ProcessJumpTarget()
+{
+  if (m_JumpTargetId.empty()) return;
+
+  if (m_JumpTargetChat != m_CurrentChat)
+  {
+    m_JumpTargetId.clear(); // user switched chat
+    return;
+  }
+
+  const std::vector<std::string>& messageVec = m_MessageVec[m_CurrentChat.first][m_CurrentChat.second];
+  if (std::find(messageVec.begin(), messageVec.end(), m_JumpTargetId) != messageVec.end())
+  {
+    const std::string target = m_JumpTargetId;
+    m_JumpTargetId.clear();
+    m_Notice.clear();
+    SelectMessageById(target);
+    return;
+  }
+
+  const int64_t nowMs = TimeUtil::GetCurrentTimeMSec();
+  if ((nowMs - m_JumpLastStepMs) < 600) return;
+  m_JumpLastStepMs = nowMs;
+
+  if (++m_JumpTries > 25)
+  {
+    m_JumpTargetId.clear();
+    SetNotice("Quoted message not found in the local history");
+    return;
+  }
+
+  // step to the oldest loaded message so the next page of history is requested
+  int& messageOffset = m_MessageOffset[m_CurrentChat.first][m_CurrentChat.second];
+  messageOffset = std::max(0, (int)messageVec.size() - 1);
+  RequestMessagesCurrentChat();
+  UpdateHistory();
+}
+
+void UiModel::Impl::OnMouse(int p_X, int p_Y, unsigned long p_State)
+{
+  AnyUserKeyInput();
+  if (GetEditMessageActive()) return;
+
+  // wheel: scroll the messages (older / newer)
+  if (p_State & (BUTTON4_PRESSED | BUTTON5_PRESSED))
+  {
+    const std::string& profileId = m_CurrentChat.first;
+    const std::string& chatId = m_CurrentChat.second;
+    if (profileId.empty()) return;
+    const int messageCount = m_Messages[profileId][chatId].size();
+    int& messageOffset = m_MessageOffset[profileId][chatId];
+    if (p_State & BUTTON4_PRESSED)
+    {
+      messageOffset = std::min(messageOffset + 2, std::max(0, messageCount - 1));
+      RequestMessagesCurrentChat();
+    }
+    else
+    {
+      messageOffset = std::max(0, messageOffset - 2);
+    }
+
+    UpdateHistory();
+    return;
+  }
+
+  if (!(p_State & BUTTON1_PRESSED)) return;
+  LOG_DEBUG("tap at %d,%d", p_X, p_Y);
+
+  auto hit = [&](const std::vector<UiHitRegion>& p_Regions) -> const UiHitRegion*
+  {
+    for (auto it = p_Regions.rbegin(); it != p_Regions.rend(); ++it) // later regions sit on top
+    {
+      if ((p_X >= it->x) && (p_X < it->x + it->w) && (p_Y >= it->y) && (p_Y < it->y + it->h)) return &*it;
+    }
+
+    return nullptr;
+  };
+
+  LOG_DEBUG("hit regions: list %d history %d", (int)m_HitList.size(), (int)m_HitHistory.size());
+  if (const UiHitRegion* region = hit(m_HitTopic))
+  {
+    SetSendTopic(region->id);
+    return;
+  }
+
+  if (const UiHitRegion* region = hit(m_HitList))
+  {
+    LOG_DEBUG("list region type %d", region->type);
+    if (region->type == UiHitRegion::Tab)
+    {
+      OnKeySetTab(region->index);
+    }
+    else if (region->type == UiHitRegion::Chat)
+    {
+      for (int i = 0; i < (int)m_ChatVec.size(); ++i)
+      {
+        if ((m_ChatVec.at(i).first == region->profileId) && (m_ChatVec.at(i).second == region->id))
+        {
+          m_CurrentChatIndex = i;
+          m_CurrentChat = m_ChatVec.at(i);
+          m_FocusList = true;
+          OnCurrentChatChanged();
+          SetSelectMessageActive(false);
+          UpdateList();
+          break;
+        }
+      }
+    }
+
+    return;
+  }
+
+  if (const UiHitRegion* region = hit(m_HitHistory))
+  {
+    LOG_DEBUG("history region type %d at %d,%d %dx%d", region->type, region->x, region->y, region->w, region->h);
+    if (region->type == UiHitRegion::Quote) LOG_DEBUG("tap on quote card of %s", region->id.c_str());
+    if (region->type == UiHitRegion::Quote) JumpToQuotedOf(region->id);
+    else if (region->type == UiHitRegion::Bubble) SelectMessageById(region->id);
+  }
+}
