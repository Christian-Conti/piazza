@@ -0,0 +1,66 @@
+// uitopiclistdialog.cpp
+//
+// Telegram forum topic picker (piazza). nchat is distributed under the MIT license, see LICENSE for details.
+
+#include "uitopiclistdialog.h"
+
+#include "strutil.h"
+
+UiTopicListDialog::UiTopicListDialog(const UiDialogParams& p_Params,
+                                     const std::vector<std::pair<std::string, int>>& p_Topics,
+                                     const std::string& p_Current)
+  : UiListDialog(p_Params, false /*p_ShadeHidden*/)
+  , m_Topics(p_Topics)
+  , m_Current(p_Current)
+{
+  UpdateList();
+}
+
+UiTopicListDialog::~UiTopicListDialog()
+{
+}
+
+std::string UiTopicListDialog::GetSelectedTopic() const
+{
+  return m_Selected;
+}
+
+void UiTopicListDialog::OnSelect()
+{
+  if (m_ItemTopics.empty()) return;
+
+  m_Selected = m_ItemTopics[m_Index];
+  m_Result = true;
+  m_Running = false;
+}
+
+void UiTopicListDialog::OnBack()
+{
+}
+
+bool UiTopicListDialog::OnTimer()
+{
+  return false;
+}
+
+void UiTopicListDialog::UpdateList()
+{
+  m_Index = 0;
+  m_Items.clear();
+  m_ItemTopics.clear();
+
+  const std::string filter = StrUtil::ToFold(StrUtil::ToString(m_FilterStr));
+  auto add = [&](const std::string& topic, const std::string& label)
+  {
+    if (!filter.empty() && (StrUtil::ToFold(label).find(filter) == std::string::npos)) return;
+    if (topic == m_Current) m_Index = (int)m_Items.size();
+    m_Items.push_back(StrUtil::TrimPadWString(StrUtil::ToWString(label), m_W));
+    m_ItemTopics.push_back(topic);
+  };
+
+  add("", "(all topics)");
+  for (const auto& topic : m_Topics)
+  {
+    add(topic.first, "#" + topic.first + "  (" + std::to_string(topic.second) + ")");
+  }
+}
