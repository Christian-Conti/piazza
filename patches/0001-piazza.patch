+};
+
+bool IsAudioPath(const std::string& p_Path);
+bool IsVoiceNotePath(const std::string& p_Path); // small voice-message formats worth auto-downloading
+int Duration(const std::string& p_Path); // seconds, 0 if unknown (needs ffprobe); cached
+State GetState(const std::string& p_Path);
+bool IsPlaying(); // a track is loaded and not paused: the UI should keep redrawing
+void Toggle(const std::string& p_Path); // start / pause / resume
+void Stop();
+bool Poll(); // reap a finished player; true when playback just ended
+}
