+
+namespace UiImage
+{
+static std::string s_Signature;
+
+bool Enabled()
+{
+  static const bool enabled = (getenv("KITTY_WINDOW_ID") != nullptr);
+  return enabled;
+}
+
+bool CellPixelSize(int& p_W, int& p_H);
+
+// reads width/height from the file header, no decoding
+bool ImagePixelSize(const std::string& p_Path, int& p_W, int& p_H)
+{
+  static std::map<std::string, std::pair<int, int>> cache;
+  auto it = cache.find(p_Path);
+  if (it != cache.end())
+  {
+    p_W = it->second.first;
+    p_H = it->second.second;
+    return p_W > 0;
+  }
+
+  int w = 0, h = 0;
+  FILE* f = fopen(p_Path.c_str(), "rb");
+  if (f != nullptr)
+  {
+    std::vector<uint8_t> b(512 * 1024);
+    const size_t n = fread(b.data(), 1, b.size(), f);
+    fclose(f);
+    b.resize(n);
+    auto be16 = [&](size_t i) { return (int)((b[i] << 8) | b[i + 1]); };
+    auto be32 = [&](size_t i) { return (int)((b[i] << 24) | (b[i + 1] << 16) | (b[i + 2] << 8) | b[i + 3]); };
+    if ((n > 24) && (b[0] == 0x89) && (b[1] == 'P'))
+    {
+      w = be32(16);
+      h = be32(20);
+    }
+    else if ((n > 10) && (b[0] == 'G') && (b[1] == 'I') && (b[2] == 'F'))
+    {
+      w = b[6] | (b[7] << 8);
+      h = b[8] | (b[9] << 8);
+    }
+    else if ((n > 30) && (b[0] == 'R') && (b[1] == 'I') && (b[8] == 'W') && (b[9] == 'E'))
+    {
+      if ((b[12] == 'V') && (b[15] == 'X'))
+      {
+        w = 1 + (b[24] | (b[25] << 8) | (b[26] << 16));
+        h = 1 + (b[27] | (b[28] << 8) | (b[29] << 16));
+      }
+      else if ((b[12] == 'V') && (b[15] == 'L'))
+      {
+        w = 1 + (((b[22] & 0x3f) << 8) | b[21]);
+        h = 1 + (((b[24] & 0x0f) << 10) | (b[23] << 2) | ((b[22] & 0xc0) >> 6));
+      }
+      else if ((b[12] == 'V') && (b[15] == ' '))
+      {
+        w = (b[26] | (b[27] << 8)) & 0x3fff;
+        h = (b[28] | (b[29] << 8)) & 0x3fff;
+      }
+    }
+    else if ((n > 4) && (b[0] == 0xFF) && (b[1] == 0xD8))
+    {
+      size_t i = 2;
+      while (i + 9 < n)
+      {
+        if (b[i] != 0xFF) { ++i; continue; }
+        const int marker = b[i + 1];
+        if ((marker >= 0xC0) && (marker <= 0xCF) && (marker != 0xC4) && (marker != 0xC8) && (marker != 0xCC))
+        {
+          h = be16(i + 5);
+          w = be16(i + 7);
+          break;
+        }
+
+        if ((marker == 0xFF) || (marker == 0x01) || ((marker >= 0xD0) && (marker <= 0xD9))) { i += 2; continue; }
+        i += 2 + be16(i + 2);
+      }
+    }
+  }
+
+  cache[p_Path] = std::make_pair(w, h);
+  p_W = w;
+  p_H = h;
+  return w > 0;
+}
+
+bool IsImagePath(const std::string& p_Path)
+{
+  const size_t dot = p_Path.rfind('.');
+  if (dot == std::string::npos) return false;
+  std::string ext = p_Path.substr(dot + 1);
+  std::transform(ext.begin(), ext.end(), ext.begin(), ::tolower);
+  return (ext == "jpg") || (ext == "jpeg") || (ext == "png") || (ext == "webp") || (ext == "gif");
+}
+
+bool IsVideoPath(const std::string& p_Path)
+{
+  const size_t dot = p_Path.rfind('.');
+  if (dot == std::string::npos) return false;
+  std::string ext = p_Path.substr(dot + 1);
+  std::transform(ext.begin(), ext.end(), ext.begin(), ::tolower);
+  return (ext == "mp4") || (ext == "webm") || (ext == "mov") || (ext == "mkv") || (ext == "m4v") ||
+    (ext == "f4v") || (ext == "3gp") || (ext == "avi") || (ext == "mpg") || (ext == "mpeg");
+}
+
+bool CanThumbnailVideos()
+{
+  static const bool hasFfmpeg = (system("command -v ffmpeg >/dev/null 2>&1") == 0);
+  return hasFfmpeg;
+}
+
+static std::mutex s_AutoMutex;
+static std::set<std::string> s_AutoIds;
+static std::set<std::string> s_AutoFiles;
+
+// Every file is also listed on disk, so a crash or kill -9 still gets cleaned at the next start.
+static std::string ManifestPath()
+{
+  return FileUtil::GetApplicationDir() + "/temp/autodl.list";
+}
+
+void DeleteAutoFiles()
+{
+  std::lock_guard<std::mutex> lock(s_AutoMutex);
+  for (const auto& path : s_AutoFiles) std::remove(path.c_str());
+  s_AutoFiles.clear();
+  std::remove(ManifestPath().c_str());
+}
+
+void CleanupStale()
+{
+  FILE* f = fopen(ManifestPath().c_str(), "r");
+  if (f == nullptr) return;
+
+  char line[4096];
+  while (fgets(line, sizeof(line), f) != nullptr)
+  {
+    std::string path(line);
+    while (!path.empty() && ((path.back() == '\n') || (path.back() == '\r'))) path.pop_back();
+    if (!path.empty()) std::remove(path.c_str());
+  }
+
+  fclose(f);
+  std::remove(ManifestPath().c_str());
+}
+
+void MarkAutoDownload(const std::string& p_FileId) { s_AutoIds.insert(p_FileId); }
+bool IsAutoDownload(const std::string& p_FileId) { return s_AutoIds.count(p_FileId) > 0; }
+
+void RememberAutoFile(const std::string& p_Path)
+{
+  static const bool registered = (std::atexit(DeleteAutoFiles) == 0);
+  std::lock_guard<std::mutex> lock(s_AutoMutex);
+  if (!registered || !s_AutoFiles.insert(p_Path).second) return;
+
+  FileUtil::MkDir(FileUtil::GetApplicationDir() + "/temp");
+  FILE* f = fopen(ManifestPath().c_str(), "a");
+  if (f != nullptr)
+  {
+    fputs((p_Path + "\n").c_str(), f);
+    fclose(f);
+  }
+}
+
+// shortcut: blocking ffmpeg call on first draw, cached afterwards; upgrade to async if slow
+static std::string ConvertToPng(const std::string& p_Path, const std::string& p_FrameArgs)
+{
+  if (!CanThumbnailVideos()) return "";
+
+  const std::string out = FileUtil::GetApplicationDir() + "/temp/thumb_" +
+    std::to_string(std::hash<std::string>()(p_Path)) + ".png";
+  if (FileUtil::Exists(out)) return out;
+
+  FileUtil::MkDir(FileUtil::GetApplicationDir() + "/temp");
+  const std::string cmd = "ffmpeg -loglevel quiet -y -i '" + StrUtil::EscapeSingleQuote(p_Path) + "' " + p_FrameArgs +
+    " '" + out + "' </dev/null >/dev/null 2>&1";
+  if (system(cmd.c_str()) != 0) return "";
+  if (!FileUtil::Exists(out)) return "";
+  RememberAutoFile(out); // converted copies are session-only too
+  return out;
+}
+
+std::string VideoThumbnail(const std::string& p_Path)
+{
+  return ConvertToPng(p_Path, "-frames:v 1 -vf scale=480:-2");
+}
+
+// Looping silent GIF of the first seconds, built in the background so the bubble shows the still frame at once
+// and starts moving when the GIF is ready. One ffmpeg at a time. shortcut: 8 s at 10 fps, 320 px wide.
+static std::atomic<bool> s_AnimReady(false);
+bool TakeAnimReady() { return s_AnimReady.exchange(false); }
+
+std::string VideoAnimation(const std::string& p_Path)
+{
+  if (!CanThumbnailVideos()) return "";
+
+  const std::string out = FileUtil::GetApplicationDir() + "/temp/anim_" +
+    std::to_string(std::hash<std::string>()(p_Path)) + ".gif";
+  if (FileUtil::Exists(out)) return out;
+
+  static std::mutex mtx;
+  static std::set<std::string> started;
+  {
+    std::lock_guard<std::mutex> lock(mtx);
+    if (!started.insert(p_Path).second) return "";
+  }
+
+  std::thread([p_Path, out]() {
+    static std::mutex convMtx; // one ffmpeg at a time
+    std::lock_guard<std::mutex> lock(convMtx);
+    FileUtil::MkDir(FileUtil::GetApplicationDir() + "/temp");
+    const std::string tmp = out + ".part";
+    const std::string cmd = "ffmpeg -loglevel quiet -y -t 8 -i '" + StrUtil::EscapeSingleQuote(p_Path) +
+      "' -an -f gif -vf \"fps=10,scale='min(320,iw)':-2:flags=bilinear,split[a][b];[a]palettegen=max_colors=96[p];"
+      "[b][p]paletteuse\" '" + tmp + "' </dev/null >/dev/null 2>&1";
+    if ((system(cmd.c_str()) == 0) && FileUtil::Exists(tmp) && (std::rename(tmp.c_str(), out.c_str()) == 0))
+    {
+      RememberAutoFile(out);
+      s_AnimReady = true;
+    }
+    else
+    {
+      std::remove(tmp.c_str());
+    }
+  }).detach();
+  return "";
+}
+
+// kitty's decoder rejects some WhatsApp .webp variants (lossy + alpha); ffmpeg reads them, so go through PNG
+std::string DisplayablePath(const std::string& p_Path)
+{
+  const size_t dot = p_Path.rfind('.');
+  std::string ext = (dot == std::string::npos) ? "" : p_Path.substr(dot + 1);
+  std::transform(ext.begin(), ext.end(), ext.begin(), ::tolower);
+  if (ext != "webp") return p_Path;
+
+  const std::string png = ConvertToPng(p_Path, "-frames:v 1");
+  return png.empty() ? p_Path : png;
+}
+
+static void Run(const std::string& p_Args)
+{
+  // find kitten on PATH, else next to the kitty install; save/restore cursor around raw output
+  static const std::string kitten = "\"$(command -v kitten || echo \"$HOME/.local/kitty.app/bin/kitten\")\"";
+  fputs("\x1b" "7", stdout);
+  fflush(stdout);
+  const std::string cmd = kitten + " icat --stdin=no --transfer-mode=stream " + p_Args + " 2>/dev/null";
+  if (system(cmd.c_str()) != 0) {}
+  fputs("\x1b" "8", stdout);
+  fflush(stdout);
+}
+
+struct Rgb
+{
+  uint8_t r = 0, g = 0, b = 0;
+};
+static Rgb s_Palette[64];
+static Rgb s_Background;
+static bool s_BackgroundKnown = false;
+static bool s_PaletteReady = false;
+
+// Parse OSC 4 replies: ESC ] 4 ; N ; rgb:RRRR/GGGG/BBBB (ESC \ | BEL)
+static int ParsePalette(const std::string& p_Buf)
+{
+  int found = 0;
+  size_t pos = 0;
+  while ((pos = p_Buf.find("\x1b]4;", pos)) != std::string::npos)
+  {
+    const size_t numEnd = p_Buf.find(';', pos + 4);
+    const size_t rgb = p_Buf.find("rgb:", pos);
+    if ((numEnd == std::string::npos) || (rgb == std::string::npos)) break;
+    const int idx = atoi(p_Buf.substr(pos + 4, numEnd - (pos + 4)).c_str());
+    size_t end = rgb + 4;
+    while ((end < p_Buf.size()) && (p_Buf[end] != '\x1b') && (p_Buf[end] != '\a')) ++end;
+    if (end >= p_Buf.size()) break; // incomplete, wait for more
+    const std::string spec = p_Buf.substr(rgb + 4, end - (rgb + 4));
+    int ch[3] = { 0, 0, 0 };
+    size_t start = 0;
+    bool ok = true;
+    for (int i = 0; i < 3; ++i)
+    {
+      const size_t slash = spec.find('/', start);
+      const std::string hex = spec.substr(start, (slash == std::string::npos) ? std::string::npos : slash - start);
+      if (hex.empty() || (hex.size() > 4)) { ok = false; break; }
+      const long value = strtol(hex.c_str(), nullptr, 16);
+      const long maxv = (1L << (4 * hex.size())) - 1;
+      ch[i] = (int)((value * 255) / maxv);
+      start = (slash == std::string::npos) ? spec.size() : slash + 1;
+    }
+
+    if (ok && (idx >= 0) && (idx < 16))
+    {
+      s_Palette[idx] = { (uint8_t)ch[0], (uint8_t)ch[1], (uint8_t)ch[2] };
+      ++found;
+    }
+
+    pos = end;
+  }
+
+  // default background: ESC ] 11 ; rgb:RRRR/GGGG/BBBB
+  const size_t bgPos = p_Buf.find("\x1b]11;rgb:");
+  if (bgPos != std::string::npos)
+  {
+    size_t end = bgPos + 9;
+    while ((end < p_Buf.size()) && (p_Buf[end] != '\x1b') && (p_Buf[end] != '\a')) ++end;
+    if (end < p_Buf.size())
+    {
+      const std::string spec = p_Buf.substr(bgPos + 9, end - (bgPos + 9));
+      int ch[3] = { 0, 0, 0 };
+      size_t start = 0;
+      bool ok = true;
+      for (int i = 0; i < 3; ++i)
+      {
+        const size_t slash = spec.find('/', start);
+        const std::string hex = spec.substr(start, (slash == std::string::npos) ? std::string::npos : slash - start);
+        if (hex.empty() || (hex.size() > 4)) { ok = false; break; }
+        ch[i] = (int)((strtol(hex.c_str(), nullptr, 16) * 255) / ((1L << (4 * hex.size())) - 1));
+        start = (slash == std::string::npos) ? spec.size() : slash + 1;
+      }
+
+      if (ok)
+      {
+        s_Background = { (uint8_t)ch[0], (uint8_t)ch[1], (uint8_t)ch[2] };
+        s_BackgroundKnown = true;
+      }
+    }
+  }
+
+  return found;
+}
+
+bool PaletteReady()
+{
+  return s_PaletteReady;
+}
+
+bool PaletteColor(int p_Idx, int& p_R, int& p_G, int& p_B)
+{
+  if (!s_PaletteReady || (p_Idx < 0) || (p_Idx >= 16)) return false;
+  p_R = s_Palette[p_Idx].r;
+  p_G = s_Palette[p_Idx].g;
+  p_B = s_Palette[p_Idx].b;
+  return true;
+}
+
+bool BackgroundColor(int& p_R, int& p_G, int& p_B)
+{
+  if (!s_PaletteReady) return false;
+  const Rgb& c = s_BackgroundKnown ? s_Background : s_Palette[0];
+  p_R = c.r;
+  p_G = c.g;
+  p_B = c.b;
+  return true;
+}
+
+void SetPaletteColor(int p_Idx, int p_R, int p_G, int p_B)
+{
+  if ((p_Idx >= 0) && (p_Idx < 64)) s_Palette[p_Idx] = { (uint8_t)p_R, (uint8_t)p_G, (uint8_t)p_B };
+}
+
+void QueryPalette()
+{
+  if (!Enabled() || !isatty(STDIN_FILENO) || !isatty(STDOUT_FILENO)) return;
+
+  struct termios saved;
+  if (tcgetattr(STDIN_FILENO, &saved) != 0) return;
+  struct termios raw = saved;
+  cfmakeraw(&raw);
+  tcsetattr(STDIN_FILENO, TCSANOW, &raw);
+
+  std::string query;
+  for (int i = 0; i < 16; ++i) query += "\x1b]4;" + std::to_string(i) + ";?\x1b\\";
+  query += "\x1b]11;?\x1b\\"; // default background too
+  if (write(STDOUT_FILENO, query.c_str(), query.size()) < 0) {}
+
+  std::string buf;
+  const int64_t deadline = TimeUtil::GetCurrentTimeMSec() + 500;
+  int found = 0;
+  while (TimeUtil::GetCurrentTimeMSec() < deadline)
+  {
+    struct pollfd pfd = { STDIN_FILENO, POLLIN, 0 };
+    if (poll(&pfd, 1, 80) <= 0)
+    {
+      if (found > 0) break; // replies stopped arriving
+      continue;
+    }
+
+    char tmp[512];
+    const ssize_t n = read(STDIN_FILENO, tmp, sizeof(tmp));
+    if (n <= 0) break;
+    buf.append(tmp, n);
+    found = ParsePalette(buf);
+    if ((found >= 16) && (buf.find("\x1b]11;rgb:") != std::string::npos)) break;
+  }
+
+  tcsetattr(STDIN_FILENO, TCSAFLUSH, &saved);
+  s_PaletteReady = (found >= 8);
+}
+
+static bool CellPixels(int& p_W, int& p_H)
+{
+  struct winsize ws;
+  if ((ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) != 0) || (ws.ws_col == 0) || (ws.ws_row == 0)) return false;
+  p_W = ws.ws_xpixel / ws.ws_col;
+  p_H = ws.ws_ypixel / ws.ws_row;
+  return (p_W >= 4) && (p_H >= 8);
+}
+
+bool CellPixelSize(int& p_W, int& p_H)
+{
+  return CellPixels(p_W, p_H);
+}
+
+bool RoundedCornersAvailable()
+{
+  int w = 0, h = 0;
+  return Enabled() && s_PaletteReady && CellPixels(w, h);
+}
+
+static std::string Base64(const std::vector<uint8_t>& p_Data)
+{
+  static const char* tbl = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+  std::string out;
+  out.reserve(((p_Data.size() + 2) / 3) * 4);
+  for (size_t i = 0; i < p_Data.size(); i += 3)
+  {
+    const uint32_t v = (p_Data[i] << 16) | ((i + 1 < p_Data.size() ? p_Data[i + 1] : 0) << 8) |
+      (i + 2 < p_Data.size() ? p_Data[i + 2] : 0);
+    out += tbl[(v >> 18) & 63];
+    out += tbl[(v >> 12) & 63];
+    out += (i + 1 < p_Data.size()) ? tbl[(v >> 6) & 63] : '=';
+    out += (i + 2 < p_Data.size()) ? tbl[v & 63] : '=';
+  }
+
+  return out;
+}
+
+// RGBA bitmap of a 2x2-cell block holding one rounded bubble corner (4x4 supersampled for smooth edges).
+// The bubble edge sits half a cell in from the block's outer sides, matching the half-block edges around it.
+static std::vector<uint8_t> MakeCorner(int p_Shape, Rgb p_Color, int p_CellW, int p_CellH)
+{
+  const int W = 2 * p_CellW;
+  const int H = 2 * p_CellH;
+  const double x0 = p_CellW / 2.0;
+  const double y0 = p_CellH / 2.0;
+  const double R = std::min(1.4 * p_CellW, 0.7 * p_CellH);
+  std::vector<uint8_t> px((size_t)W * H * 4, 0);
+  for (int y = 0; y < H; ++y)
+  {
+    for (int x = 0; x < W; ++x)
+    {
+      int inside = 0;
+      for (int sy = 0; sy < 4; ++sy)
+      {
+        for (int sx = 0; sx < 4; ++sx)
+        {
+          double fx = x + (sx + 0.5) / 4.0;
+          double fy = y + (sy + 0.5) / 4.0;
+          if (p_Shape & 1) fx = W - fx; // mirror for the right-hand corners
+          if (p_Shape & 2) fy = H - fy; // mirror for the bottom corners
+          bool in;
+          if ((fx < x0) || (fy < y0)) in = false;
+          else if ((fx >= x0 + R) || (fy >= y0 + R)) in = true;
+          else
+          {
+            const double dx = (x0 + R) - fx;
+            const double dy = (y0 + R) - fy;
+            in = ((dx * dx) + (dy * dy)) <= (R * R);
+          }
+
+          inside += in ? 1 : 0;
+        }
+      }
+
+      uint8_t* p = &px[((size_t)y * W + x) * 4];
+      p[0] = p_Color.r;
+      p[1] = p_Color.g;
+      p[2] = p_Color.b;
+      p[3] = (uint8_t)((inside * 255) / 16);
+    }
+  }
+
+  return px;
+}
+
+// 1x1-cell bitmap: the area outside a quarter circle in one corner is painted (bubble color), the inside stays
+// transparent so the dark card cell underneath shows through with a round corner.
+static std::vector<uint8_t> MakeInverseCorner(int p_Shape, Rgb p_Color, int p_CellW, int p_CellH)
+{
+  const int W = p_CellW;
+  const int H = p_CellH;
+  const double R = std::min((double)p_CellW, p_CellH * 0.45);
+  std::vector<uint8_t> px((size_t)W * H * 4, 0);
+  for (int y = 0; y < H; ++y)
+  {
+    for (int x = 0; x < W; ++x)
+    {
+      int outside = 0;
+      for (int sy = 0; sy < 4; ++sy)
+      {
+        for (int sx = 0; sx < 4; ++sx)
+        {
+          double fx = x + (sx + 0.5) / 4.0;
+          double fy = y + (sy + 0.5) / 4.0;
+          if (p_Shape & 1) fx = W - fx;
+          if (p_Shape & 2) fy = H - fy;
+          bool out = false;
+          if ((fx < R) && (fy < R))
+          {
+            const double dx = R - fx;
+            const double dy = R - fy;
+            out = ((dx * dx) + (dy * dy)) > (R * R);
+          }
+
+          outside += out ? 1 : 0;
+        }
+      }
+
+      uint8_t* p = &px[((size_t)y * W + x) * 4];
+      p[0] = p_Color.r;
+      p[1] = p_Color.g;
+      p[2] = p_Color.b;
+      p[3] = (uint8_t)((outside * 255) / 16);
+    }
+  }
+
+  return px;
+}
+
+static std::set<uint32_t> s_Transmitted;
+static std::vector<Corner> s_LastCorners; // what the screen should currently show, for Refresh()
+static void PlaceCorners(const std::vector<Corner>& p_Corners);
+
+static void TransmitCorner(uint32_t p_Id, int p_Shape, Rgb p_Color, int p_CellW, int p_CellH, std::string& p_Out)
+{
+  if (s_Transmitted.count(p_Id)) return;
+  s_Transmitted.insert(p_Id);
+  const bool inverse = (p_Shape >= 4);
+  const int imgW = inverse ? p_CellW : 2 * p_CellW;
+  const int imgH = inverse ? p_CellH : 2 * p_CellH;
+  const std::string data = Base64(inverse ? MakeInverseCorner(p_Shape - 4, p_Color, p_CellW, p_CellH)
+                                          : MakeCorner(p_Shape, p_Color, p_CellW, p_CellH));
+  const size_t chunk = 4096;
+  for (size_t off = 0; off < data.size(); off += chunk)
+  {
+    const bool first = (off == 0);
+    const bool last = (off + chunk >= data.size());
+    p_Out += "\x1b_G";
+    if (first)
+    {
+      p_Out += "a=t,f=32,s=" + std::to_string(imgW) + ",v=" + std::to_string(imgH) + ",i=" +
+        std::to_string(p_Id) + ",q=2,";
+    }
+
+    p_Out += std::string("m=") + (last ? "0" : "1") + ";" + data.substr(off, chunk) + "\x1b\\";
+  }
+}
+
+void Invalidate()
+{
+  if (Enabled())
+  {
+    fputs("\x1b_Ga=d,d=a,q=2\x1b\\", stdout);
+    fflush(stdout);
+  }
+
+  s_Signature.clear();
+  s_LastCorners.clear();
+}
+
+void Refresh()
+{
+  if (!Enabled() || s_LastCorners.empty()) return;
+  s_Transmitted.clear(); // also re-upload the bitmaps in case the terminal dropped them
+  PlaceCorners(s_LastCorners);
+}
+
+void Clear()
+{
+  s_LastCorners.clear();
+  if (Enabled() && !s_Signature.empty())
+  {
+    const char* clearAll = "\x1b_Ga=d,d=a,q=2\x1b\\"; // delete every placement; uploaded corner bitmaps stay cached
+    fputs(clearAll, stdout);
+    fflush(stdout);
+  }
+
+  s_Signature.clear();
+}
+
+// transmits missing bitmaps and places every corner; safe to repeat (same ids replace the previous placement)
+static void PlaceCorners(const std::vector<Corner>& p_Corners)
+{
+  int cw = 0, ch = 0;
+  if (!CellPixels(cw, ch) || !s_PaletteReady || p_Corners.empty()) return;
+
+  std::string out = "\x1b" "7";
+  uint32_t placementId = 1;
+  for (const auto& c : p_Corners)
+  {
+    if ((c.colorIdx < 0) || (c.colorIdx > 63)) continue;
+    // shape needs 3 bits and the color index 6 (custom slots go up to 63): keep the fields apart or ids collide
+    const uint32_t id = 0x40000000u + ((uint32_t)((c.shape << 6) | c.colorIdx) << 16) + (uint32_t)((cw * 131 + ch) & 0xFFFF);
+    TransmitCorner(id, c.shape, s_Palette[c.colorIdx], cw, ch, out);
+    out += "\x1b[" + std::to_string(c.row + 1) + ";" + std::to_string(c.col + 1) + "H";
+    const std::string span = (c.shape >= 4) ? "c=1,r=1" : "c=2,r=2";
+    out += "\x1b_Ga=p,i=" + std::to_string(id) + ",p=" + std::to_string(placementId++) + "," + span + ",C=1,z=1,q=2\x1b\\";
+  }
+
+  out += "\x1b" "8";
+  fputs(out.c_str(), stdout);
+  fflush(stdout);
+}
+
+void ShowAll(const std::vector<Placement>& p_Placements, const std::vector<Corner>& p_Corners)
+{
+  if (!Enabled()) return;
+
+  int cw = 0, ch = 0;
+  CellPixels(cw, ch);
+
+  std::string signature;
+  for (const auto& p : p_Placements)
+  {
+    signature += p.path + "|" + std::to_string(p.x) + "," + std::to_string(p.y) + "," + std::to_string(p.cols) +
+      "x" + std::to_string(p.rows) + ";";
+  }
+
+  for (const auto& c : p_Corners)
+  {
+    signature += "c" + std::to_string(c.col) + "," + std::to_string(c.row) + "," + std::to_string(c.shape) + "," +
+      std::to_string(c.colorIdx) + ";";
+  }
+
+  signature += "@" + std::to_string(cw) + "x" + std::to_string(ch);
+  if (signature == s_Signature) return;
+
+  // clear first, always: a placement left behind a moved bubble would be a visible glitch
+  fputs("\x1b_Ga=d,d=a,q=2\x1b\\", stdout);
+  fflush(stdout);
+
+  for (const auto& p : p_Placements)
+  {
+    Run(std::string("--align=left ") + (p.z < 0 ? "--z-index=" + std::to_string(p.z) + " " : "") + "--place=" +
+        std::to_string(p.cols) + "x" + std::to_string(p.rows) + "@" + std::to_string(p.x) + "x" +
+        std::to_string(p.y) + " '" + StrUtil::EscapeSingleQuote(p.path) + "'");
+  }
+
+  PlaceCorners(p_Corners);
+  s_LastCorners = p_Corners;
+
+  s_Signature = signature;
+}
+
+void Show(const std::vector<Placement>& p_Placements)
+{
+  ShowAll(p_Placements, std::vector<Corner>());
+}
+}
