+// Reply key: on a selected message it becomes the quote target and you go back to typing;
+// pressed again (or Ctrl-C) it drops the quote. With nothing selected it starts selecting.
+void UiModel::Impl::OnKeyReply()
+{
+  AnyUserKeyInput();
+  if (GetEditMessageActive()) return;
+
+  const std::string& profileId = m_CurrentChat.first;
+  const std::string& chatId = m_CurrentChat.second;
+  if (GetSelectMessageActive())
+  {
+    const std::vector<std::string>& messageVec = m_MessageVec[profileId][chatId];
+    const int messageOffset = m_MessageOffset[profileId][chatId];
+    if (messageOffset < (int)messageVec.size())
+    {
+      m_ReplyMsgId = messageVec.at(messageOffset);
+      m_ReplyChat = m_CurrentChat;
+    }
+
+    SetSelectMessageActive(false);
+  }
+  else if (HasReplyTarget())
+  {
+    ClearReplyTarget();
+  }
+  else if (!m_Messages[profileId][chatId].empty())
+  {
+    SetSelectMessageActive(true);
+  }
+
+  UpdateHistory();
+  UpdateStatus();
+}
