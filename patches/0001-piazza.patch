+void UiModel::Impl::PlayMessageSound()
+{
+  static const bool soundEnabled = UiConfig::GetBool("sound_enabled");
+  if (!soundEnabled) return;
+
+  static const std::string cmd = [this]()
+  {
+    std::string configured = UiConfig::GetStr("sound_command");
+    if (!configured.empty()) return configured;
+
+    const std::string file = "/usr/share/sounds/freedesktop/stereo/message-new-instant.oga";
+    if (!FileUtil::Exists(file)) return std::string();
+    for (const std::string player : { "pw-play", "paplay" })
+    {
+      if (RunCommand("command -v " + player + " >/dev/null 2>&1")) return player + " '" + file + "'";
+    }
+
+    return std::string();
+  }();
+  if (cmd.empty()) return;
+
+  // one sound per second at most, so a burst of messages does not stack up
+  static int64_t lastSoundMs = 0;
+  const int64_t nowMs = TimeUtil::GetCurrentTimeMSec();
+  if ((nowMs - lastSoundMs) < 1000) return;
+  lastSoundMs = nowMs;
+
+  RunProgram(cmd + " >/dev/null 2>&1 &");
+}
