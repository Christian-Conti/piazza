--- /dev/null
+++ b/src/uiimage.h
@@ -0,0 +1,59 @@
+// uiimage.h
+//
+// Inline image display in kitty-graphics-capable terminals (via `kitten icat`).
+
+#pragma once
+
+#include <string>
+#include <vector>
+
+namespace UiImage
+{
+struct Placement
+{
+  std::string path;
+  int x = 0; // screen cell column (0-based)
+  int y = 0; // screen cell row (0-based)
+  int cols = 0;
+  int rows = 0;
+  int z = 0; // negative: text is drawn over the picture (used for the video play badge)
+};
+
+bool Enabled();
+bool ImagePixelSize(const std::string& p_Path, int& p_W, int& p_H); // png/jpeg/gif/webp header, cached
+bool CellPixelSize(int& p_W, int& p_H); // size of one terminal cell in pixels, false if unknown
+bool IsImagePath(const std::string& p_Path);
+bool IsVideoPath(const std::string& p_Path); // mp4/webm/mov/mkv: Telegram/WhatsApp "GIFs" are mp4
+std::string DisplayablePath(const std::string& p_Path); // image path kitty can decode (webp -> png via ffmpeg)
+std::string VideoThumbnail(const std::string& p_Path); // first frame as PNG via ffmpeg, "" if unavailable
+std::string VideoAnimation(const std::string& p_Path); // looping GIF if ready, else "" and starts building it
+bool TakeAnimReady(); // true once after a GIF became ready: redraw the history
+bool CanThumbnailVideos(); // ffmpeg present
+// files nchat fetched on its own for inline display; deleted when the session ends
+void MarkAutoDownload(const std::string& p_FileId);
+bool IsAutoDownload(const std::string& p_FileId);
+void RememberAutoFile(const std::string& p_Path);
+void DeleteAutoFiles(); // delete everything fetched for inline display (idempotent)
+void CleanupStale(); // delete leftovers of a previous session that did not exit cleanly
+void Show(const std::vector<Placement>& p_Placements); // no-op if unchanged since last call
+
+// Rounded bubble corners: 2x2-cell images with an antialiased arc, in the exact RGB of the terminal palette.
+struct Corner
+{
+  int col = 0; // screen cell of the top-left of the 2x2 block
+  int row = 0;
+  int shape = 0; // 0..3: bubble corner (2x2 cells) top-left/top-right/bottom-left/bottom-right;
+                 // 4..7: inverse corner (1x1 cell) cutting a round hole corner into a dark quote card
+  int colorIdx = 0; // ANSI palette index 0..15
+};
+bool PaletteReady();
+bool PaletteColor(int p_Idx, int& p_R, int& p_G, int& p_B); // ANSI 0..15 as reported by the terminal
+bool BackgroundColor(int& p_R, int& p_G, int& p_B); // terminal default background (falls back to color 0)
+void SetPaletteColor(int p_Idx, int p_R, int p_G, int p_B); // register an RGB for a custom color slot (16..63)
+void QueryPalette(); // ask the terminal for its 16 ANSI colors; call once before ncurses starts
+bool RoundedCornersAvailable();
+void ShowAll(const std::vector<Placement>& p_Placements, const std::vector<Corner>& p_Corners);
+void Invalidate(); // the screen was cleared/redrawn: forget what is on it so the next ShowAll draws everything again
+void Refresh(); // re-send the corner images (cheap, idempotent) to heal any loss the terminal did not tell us about
+void Clear();
+}
