@@ -0,0 +1,89 @@
+// uitopicview.cpp
+//
+// Telegram forum topic column next to the conversation (piazza). nchat is distributed under the MIT license,
+// see LICENSE for details.
+
+#include "uitopicview.h"
+
+#include <ncurses.h>
+
+#include "strutil.h"
+#include "uicolorconfig.h"
+#include "uimodel.h"
+
+UiTopicView::UiTopicView(const UiViewParams& p_Params)
+  : UiViewBase(p_Params)
+{
+}
+
+UiTopicView::~UiTopicView()
+{
+}
+
+void UiTopicView::Draw()
+{
+  if (!m_Enabled || !m_Dirty) return;
+  m_Dirty = false;
+
+  static int colorPair = UiColorConfig::GetColorPair("list_color");
+  static int attribute = UiColorConfig::GetAttribute("list_attr");
+  static int attributeSelected = UiColorConfig::GetAttribute("list_attr_selected");
+  static int colorPairUnread = UiColorConfig::GetColorPair("list_color_unread");
+  static int selectedColor = UiColorConfig::GetColorPair("list_selected_color");
+  static int borderColor = UiColorConfig::GetColorPair("listborder_color");
+  static int borderAttr = UiColorConfig::GetAttribute("listborder_attr");
+
+  std::vector<UiTopicRow> rows;
+  std::string current;
+  m_Model->GetTopicRowsLocked(rows, current);
+
+  werase(m_Win);
+  wbkgd(m_Win, attribute | colorPair | ' ');
+
+  const int textW = m_W - 1; // last column is the separator
+  std::vector<UiHitRegion> hits;
+  wattron(m_Win, attribute | colorPair | A_BOLD);
+  mvwaddnwstr(m_Win, 0, 1, L"Topics", 6);
+  wattroff(m_Win, A_BOLD);
+
+  for (int i = 0; (i <= (int)rows.size()) && ((i + 2) < m_H); ++i)
+  {
+    const bool isAll = (i == 0);
+    const UiTopicRow* row = isAll ? nullptr : &rows[i - 1];
+    const std::string name = isAll ? "" : row->name;
+    const bool selected = (name == current);
+    std::string label = isAll ? "All" : ("#" + row->name);
+    std::string badge = (row != nullptr && row->unread > 0) ? (" " + std::to_string(row->unread)) : "";
+
+    std::wstring wbadge = StrUtil::ToWString(badge);
+    std::wstring wlabel = StrUtil::ToWString(label);
+    const int room = std::max(1, textW - 1 - StrUtil::WStringWidth(wbadge));
+    if (StrUtil::WStringWidth(wlabel) > room) wlabel = StrUtil::TrimPadWString(wlabel, room - 1) + L"…";
+    std::wstring line = StrUtil::TrimPadWString(L" " + wlabel, textW - StrUtil::WStringWidth(wbadge)) + wbadge;
+    line = StrUtil::TrimPadWString(line, textW);
+
+    const int y = i + 2;
+    if (selected) wattron(m_Win, attributeSelected | selectedColor);
+    else if (row != nullptr && row->unread > 0) wattron(m_Win, attribute | colorPairUnread);
+    mvwaddnwstr(m_Win, y, 0, line.c_str(), line.size());
+    wattroff(m_Win, attributeSelected | selectedColor | colorPairUnread);
+    wattron(m_Win, attribute | colorPair);
+
+    UiHitRegion hit;
+    hit.type = UiHitRegion::Topic;
+    hit.x = m_X;
+    hit.y = m_Y + y;
+    hit.w = textW;
+    hit.h = 1;
+    hit.id = name;
+    hits.push_back(hit);
+  }
+
+  wattron(m_Win, borderAttr | borderColor);
+  mvwvline(m_Win, 0, m_W - 1, ACS_VLINE, m_H);
+  wattroff(m_Win, borderAttr | borderColor);
+  wattroff(m_Win, attribute | colorPair);
+  wrefresh(m_Win);
+
+  m_Model->SetTopicHitsLocked(hits);
+}
